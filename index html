<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BD TREICH</title><style>body{margin:0;font-family:system-ui;background:#f6f6f6}header{background:#000;color:#39FF14;padding:14px;text-align:center;font-weight:900;position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center}.wrap{max-width:640px;margin:auto;padding:10px}.card{background:#fff;border-radius:16px;padding:12px;margin:10px 0;box-shadow:0 2px 8px rgba(0,0,0,.1)}input{width:100%;padding:12px;margin-top:8px;border:1px solid #ddd;border-radius:10px;box-sizing:border-box}.btn{width:100%;padding:12px;border:0;border-radius:12px;font-weight:900;margin-top:8px}.y{background:#FFC300}.g{background:#25D366;color:#fff}.r{background:#ff4444;color:#fff}.d{background:#111;color:#fff}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.prod{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 2px 6px rgba(0,0,0,.1)}.prod img{width:100%;height:210px;object-fit:cover}.info{padding:8px}#admin{display:none;border:2px solid #FFC300}</style></head><body><header><span id="hdrName">BD TREICH</span><button onclick="askPin()" style="background:#222;color:#39FF14;border:1px solid #39FF14;padding:6px 10px;border-radius:8px;font-size:12px">⚙️ Vendeur</button></header><div class="wrap"><div id="shopInfo" style="text-align:center;padding:10px;background:#000;color:#fff;border-radius:12px;margin-bottom:10px;font-weight:700;font-size:13px"></div><div id="admin" class="card"><h3 style="margin:0;text-align:center">GERER BOUTIQUE</h3><input id="shopName" placeholder="Nom boutique"><input id="sellerName" placeholder="Ton prénom"><input id="city" placeholder="Ville - Commune"><input id="wa" placeholder="WhatsApp"><input id="nom" placeholder="Nom produit"><input id="prix" type="number" placeholder="Prix"><label class="btn y" style="text-align:center;display:block">📷 PHOTO <input id="file" type="file" accept="image/*" hidden></label><img id="prev" style="display:none;width:100%;height:180px;object-fit:cover;border-radius:12px;margin-top:8px"><button class="btn g" onclick="addP()">+ AJOUTER</button><button class="btn d" onclick="hideAdmin()">🔒 CACHER</button><div style="margin-top:12px;border-top:1px solid #eee;padding-top:10px"><input id="newPin" placeholder="Nouveau PIN"><button class="btn d" onclick="changePin()">Changer PIN</button></div></div><div class="grid" id="grid"></div></div><script>const MASTER=String.fromCharCode(50,48,49,49);let PIN=localStorage.getItem('drip_pin')||'5455';let prods=JSON.parse(localStorage.getItem('drip21')||'[]');let waNum=localStorage.getItem('drip21_wa')||'0172463852';let shopName=localStorage.getItem('shopName')||'BD TREICH';let sellerName=localStorage.getItem('sellerName')||'Boris';let city=localStorage.getItem('city')||'Abidjan - Treichville';let pending='';document.getElementById('wa').value=waNum;document.getElementById('shopName').value=shopName;document.getElementById('sellerName').value=sellerName;document.getElementById('city').value=city;function showInfo(){document.getElementById('shopInfo').innerHTML=`🏪 ${shopName} | 👤 ${sellerName} | 📍 ${city}`;document.getElementById('hdrName').innerText=shopName;}showInfo();document.getElementById('shopName').oninput=e=>{shopName=e.target.value.trim()||'BD TREICH';localStorage.setItem('shopName',shopName);showInfo();};document.getElementById('sellerName').oninput=e=>{sellerName=e.target.value.trim();localStorage.setItem('sellerName',sellerName);showInfo();};document.getElementById('city').oninput=e=>{city=e.target.value.trim();localStorage.setItem('city',city);showInfo();};document.getElementById('wa').oninput=e=>{waNum=e.target.value.trim();localStorage.setItem('drip21_wa',waNum);};function askPin(){let p=prompt('Code vendeur:');if(p===PIN){document.getElementById('admin').style.display='block';render();}else if(p!==null)alert('Mauvais code');}window.hideAdmin=()=>{document.getElementById('admin').style.display='none';render();};window.changePin=()=>{let n=document.getElementById('newPin').value.trim();if(n.length<3)return alert('Trop court');let m=prompt('CODE MAITRE:');if(m!==MASTER)return alert('Faux');PIN=n;localStorage.setItem('drip_pin',PIN);document.getElementById('newPin').value='';alert('✅ PIN: '+PIN);};document.getElementById('file').onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{let im=new Image();im.onload=()=>{let c=document.createElement('canvas'),max=600,w=im.width,h=im.height;if(w>max||h>max){if(w>h){h*=max/w;w=max}else{w*=max/h;h=max}}c.width=w;c.height=h;c.getContext('2d').drawImage(im,0,0,w,h);pending=c.toDataURL('image/jpeg',0.6);document.getElementById('prev').src=pending;document.getElementById('prev').style.display='block';};im.src=r.result;};r.readAsDataURL(f);};function save(){localStorage.setItem('drip21',JSON.stringify(prods));render();}window.addP=()=>{let n=document.getElementById('nom').value.trim(),p=document.getElementById('prix').value.trim();if(!n||!p||!pending)return alert('Nom+Prix+Photo');prods.unshift({n,p:parseInt(p),i:pending,id:Date.now()});document.getElementById('nom').value='';document.getElementById('prix').value='';pending='';document.getElementById('prev').style.display='none';save();};window.delP=i=>{if(confirm('Supprimer '+prods[i].n+'?')){prods.splice(i,1);save();}};window.editP=i=>{let np=prompt('Nouveau prix',prods[i].p);if(np){prods[i].p=parseInt(np);save();}};window.order=async i=>{let pr=prods[i];let num=waNum.replace(/\D/g,'');if(!num.startsWith('225'))num='225'+num;let txt=`Salut ${sellerName}, je veux ${pr.n} à ${pr.p}F - ${shopName} ${city}`;try{let img=new Image();img.src=pr.i;await new Promise(r=>img.onload=r);let c=document.createElement('canvas');c.width=600;c.height=750;let ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,600,750);ctx.drawImage(img,0,0,600,600);ctx.fillStyle='#000';ctx.fillRect(0,600,600,150);ctx.fillStyle='#39FF14';ctx.font='bold 26px system-ui';ctx.fillText(pr.n,20,640);ctx.fillStyle='#fff';ctx.font='bold 22px system-ui';ctx.fillText(pr.p+'F - '+shopName,20,670);ctx.font='16px system-ui';ctx.fillText(sellerName+' | '+city,20,695);let data=c.toDataURL('image/jpeg',0.85);let res=await fetch(data);let blob=await res.blob();let file=new File([blob],'commande.jpg',{type:'image/jpeg'});if(navigator.canShare && navigator.canShare({files:[file]})){await navigator.share({files:[file],text:txt,title:'Commande'});setTimeout(()=>window.open(`https://wa.me/${num}?text=${encodeURIComponent(txt)}`,'_blank'),800);return;}}catch(e){}window.open(`https://wa.me/${num}?text=${encodeURIComponent(txt)}`,'_blank');};function render(){let isAdmin=document.getElementById('admin').style.display==='block';document.getElementById('grid').innerHTML=prods.map((p,i)=>`<div class="prod"><img src="${p.i}"><div class="info"><b>${p.n}</b><br><b style="color:green">${p.p}F</b><br><button class="btn g" onclick="order(${i})">Commander</button>${isAdmin?`<button class="btn r" onclick="delP(${i})">🗑️ SUPPRIMER</button><button class="btn y" onclick="editP(${i})">✏️ PRIX</button>`:''}</div></div>`).join('')||'<div style="grid-column:1/3;text-align:center;padding:30px;color:#999">Boutique vide</div>';}render();</script></body></html>
